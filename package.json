{
  "name": "@evotai/evot-herdr",
  "version": "0.3.0",
  "description": "Node.js session-hook adapter for evot with Herdr CLI and herdr-app support",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "bin": { "evot-herdr": "./bin/evot-herdr" },
  "files": ["bin/", "dist/", "README.md", "CHANGELOG.md"],
  "repository": { "type": "git", "url": "git+https://github.com/sundy-li/evot-herdr.git" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "test:package": "node scripts/smoke-package.mjs",
    "test:source": "node scripts/smoke-source.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  }
}
